default_platform(:android)

platform :android do
  desc "Build AAB release"
  lane :build_release do
    gradle(
      task: "bundle",
      build_type: "Release"
    )
  end

  desc "Deploy to Google Play (Internal Track)"
  lane :deploy do
    upload_to_play_store(
      json_key_data: ENV["GOOGLE_PLAY_JSON"],
      package_name: ENV["PACKAGE_NAME"],
      track: "internal"
    )
  end
end
